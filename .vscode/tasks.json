{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--fresh",
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": "CMake Configure",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "--preset",
                "Debug",
                "--target",
                "clean"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "Flash (ST-LINK)",
            "type": "shell",
            "command": "& 'C:\\Program Files\\STMicroelectronics\\STM32Cube\\STM32CubeProgrammer\\bin\\STM32_Programmer_CLI.exe' -c port=SWD mode=UR reset=HWrst freq=400 -w '${workspaceFolder}/build/Debug/V4D-V02_11.elf' -v -rst",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Flash (ST-LINK Hotplug)",
            "type": "shell",
            "command": "& 'C:\\Program Files\\STMicroelectronics\\STM32Cube\\STM32CubeProgrammer\\bin\\STM32_Programmer_CLI.exe' -c port=SWD mode=HOTPLUG reset=SWrst freq=400 -w '${workspaceFolder}/build/Debug/V4D-V02_11.elf' -v -rst",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Build and Flash",
            "dependsOn": [
                "CMake Build",
                "Flash (ST-LINK)"
            ],
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "Build and Flash Hotplug",
            "dependsOn": [
                "CMake Build",
                "Flash (ST-LINK Hotplug)"
            ],
            "dependsOrder": "sequence",
            "group": "test",
            "problemMatcher": []
        }
    ]
}
